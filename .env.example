# Copy to .env and fill in. Real environment variables override this file.

PORT=8080

# Password for the dashboard at /admin. If empty, a random one is generated
# and printed at startup (it changes on every restart).
ADMIN_TOKEN=

# Free key from https://twelvedata.com/pricing (Basic plan).
# Leave empty to fall back to ECB daily reference rates for forex.
TWELVE_DATA_API_KEY=

# Twelve Data plan limits. Forex refresh is spaced automatically to fit
# these, based on how many instruments the dashboard has turned on.
TWELVE_DATA_CREDITS_PER_DAY=800
TWELVE_DATA_CREDITS_PER_MINUTE=8
FX_MIN_POLL_SECONDS=60

METALS_POLL_SECONDS=10
REFERENCE_REFRESH_MINUTES=360

# Where the dashboard saves the Home / Markets layout.
LAYOUT_FILE=data/layout.json

# AXP user portal (UpTrader Trader's Room). Set the base URL to connect real
# account login and balances. The portal signs each user in with their own
# email/password and issues a per-user JWT, so no API key is required — leave
# UPTRADER_API_KEY empty. Leave the URL empty and portal routes report
# "not connected".
UPTRADER_API_URL=https://login.axp-portal.com
UPTRADER_API_KEY=
